# Veritabanı — yol prisma/schema.prisma dosyasına göredir (file:./dev.db → prisma/dev.db)
DATABASE_URL="file:./dev.db"

# NextAuth — production'da güçlü bir secret üretin:
# openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
AUTH_URL="http://localhost:3001"

# Express backend (harici API — web arayüzü bunu kullanmaz)
BACKEND_URL="http://127.0.0.1:4000"
JWT_SECRET="change-me-in-production"

# Opsiyonel: ilk kurulumda örnek veri yükle (production'da false bırakın)
SEED_ON_START="false"
