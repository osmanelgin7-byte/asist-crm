# Production ortam değişkenleri — docker compose için
# Kopyalayın: cp .env.production.example .env.production

# Güçlü secret üretin: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32

# Canlı domain (sonunda / olmadan)
AUTH_URL=https://flowcrm.example.com

# İlk kurulumda örnek kullanıcılar için true, sonra false yapın
SEED_ON_START=true
